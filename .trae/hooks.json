{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/log_tool_usage.py hook --source trae --event session"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/log_tool_usage.py hook --source trae"
          }
        ]
      }
    ]
  }
}
