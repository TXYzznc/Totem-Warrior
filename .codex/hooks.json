{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/codex_prompt_hook.js session"
          },
          {
            "type": "command",
            "command": "python tools/log_tool_usage.py hook --source codex --event session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/codex_prompt_hook.js prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/log_tool_usage.py hook --source codex"
          }
        ]
      }
    ]
  }
}
